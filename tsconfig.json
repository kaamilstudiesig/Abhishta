{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@public/*": [
        "./public/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-clay/types/**/*.ts",
    ".next-clay/dev/types/**/*.ts",
    ".next-dusk/types/**/*.ts",
    ".next-dusk/dev/types/**/*.ts",
    ".next-meadow/types/**/*.ts",
    ".next-meadow/dev/types/**/*.ts",
    ".next-classic/types/**/*.ts",
    ".next-classic/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "docs"
  ]
}
