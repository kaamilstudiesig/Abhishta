{
  "name": "abhishta-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ui:clay": "NEXT_PUBLIC_UI_VARIANT=clay NEXT_DIST_DIR=.next-clay next dev -p 3001",
    "ui:clay:build": "NEXT_PUBLIC_UI_VARIANT=clay NEXT_DIST_DIR=.next-clay next build",
    "ui:clay:start": "NEXT_PUBLIC_UI_VARIANT=clay NEXT_DIST_DIR=.next-clay next start -p 3001",
    "ui:dusk": "NEXT_PUBLIC_UI_VARIANT=dusk NEXT_DIST_DIR=.next-dusk next dev -p 3002",
    "ui:dusk:build": "NEXT_PUBLIC_UI_VARIANT=dusk NEXT_DIST_DIR=.next-dusk next build",
    "ui:dusk:start": "NEXT_PUBLIC_UI_VARIANT=dusk NEXT_DIST_DIR=.next-dusk next start -p 3002",
    "ui:meadow": "NEXT_PUBLIC_UI_VARIANT=meadow NEXT_DIST_DIR=.next-meadow next dev -p 3003",
    "ui:meadow:build": "NEXT_PUBLIC_UI_VARIANT=meadow NEXT_DIST_DIR=.next-meadow next build",
    "ui:meadow:start": "NEXT_PUBLIC_UI_VARIANT=meadow NEXT_DIST_DIR=.next-meadow next start -p 3003",
    "ui:all": "sh -c 'npm run ui:clay & npm run ui:dusk & npm run ui:meadow & wait'",
    "ui:classic": "NEXT_PUBLIC_UI_VARIANT=classic NEXT_DIST_DIR=.next-classic next dev -p 3004",
    "ui:classic:build": "NEXT_PUBLIC_UI_VARIANT=classic NEXT_DIST_DIR=.next-classic next build",
    "ui:classic:start": "NEXT_PUBLIC_UI_VARIANT=classic NEXT_DIST_DIR=.next-classic next start -p 3004"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
